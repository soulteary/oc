+			query   string
+			headers map[string]string
+		}{
+			{"versionId=forbidden&versionid=allowed", nil},
+			{"versionId=forbidden&Versionid=allowed", nil},
+			{"versionId=forbidden", map[string]string{"Versionid": "allowed"}},
