+		t.Fatal(err)
+	}
+	got, err := io.ReadAll(gr)
+	gr.Close()
+	if err != nil || !bytes.Equal(got, data) {
+		t.Fatalf("FS transition removed source data: %q / %v", got, err)
+	}
+}
