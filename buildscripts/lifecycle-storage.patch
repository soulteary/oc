+func (d transitionCleanupFailDisk) DeleteVersion(ctx context.Context, bucket, key string, fi FileInfo, force bool) error {
+	if bucket == d.bucket && key == d.key && fi.TransitionStatus == lifecycle.TransitionComplete {
