+func TestBucketConfigBaseLifecycleBoundary(t *testing.T) {
+	for _, status := range []string{"Enabled", "Disabled"} {
+		for _, action := range []string{
+			`<Transition><Days>2</Days><StorageClass>archive</StorageClass></Transition>`,
+			`<NoncurrentVersionTransition><NoncurrentDays>1</NoncurrentDays><StorageClass>archive</StorageClass></NoncurrentVersionTransition>`,
+			`<Expiration><ExpiredObjectDeleteMarker>true</ExpiredObjectDeleteMarker></Expiration>`,
+		} {
+			doc := `<LifecycleConfiguration><Rule><Filter><Prefix>logs/</Prefix></Filter><Status>` + status + `</Status>` + action + `</Rule></LifecycleConfiguration>`
+			if validConditionalBucketXML([]byte(doc), bucketLifecycleConfig) {
+				t.Fatalf("base CAS accepted a storage runtime field: %s", doc)
+			}
+		}
+	}
+	for _, filter := range []string{
+		`<Tag><Key>environment</Key><Value>prod</Value></Tag>`,
+		`<And><Prefix>logs/</Prefix><Tag><Key>environment</Key><Value>prod</Value></Tag></And>`,
+	} {
+		doc := `<LifecycleConfiguration><Rule><Filter>` + filter + `</Filter><Status>Enabled</Status><Expiration><Days>2</Days></Expiration></Rule></LifecycleConfiguration>`
+		if validConditionalBucketXML([]byte(doc), bucketLifecycleConfig) {
+			t.Fatalf("base CAS accepted decoded tag runtime semantics: %s", doc)
+		}
